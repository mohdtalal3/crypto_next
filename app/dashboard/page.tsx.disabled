import { Sidebar } from "@/components/layout/Sidebar";
import { TransactionsTable } from "@/components/dashboard/TransactionsTable";
import { viewAs } from "@/lib/auth/guards";
import { transactionSummaryFor, transactionsFor, userInfoFor } from "@/lib/db/portal";
import { summarizeTransactions } from "@/lib/utils/summary";
import { number } from "@/lib/utils/format";
export default async function Dashboard({searchParams}:{searchParams:Promise<{error?:string;user?:string}>}){const {userId,viewing}=await viewAs(await searchParams);const [rows,info,cached,{error}]=await Promise.all([transactionsFor(userId),userInfoFor(userId),transactionSummaryFor(userId),searchParams]);const summary=cached.length?cached:summarizeTransactions(rows);const credentials=(info?.credentials??{}) as Record<string,unknown>;return <div className="layout"><Sidebar active="/dashboard" viewing={viewing}/><main className="wrap"><header className="topbar"><div><h1>Transactions</h1><p className="subtitle">{rows.length} transactions · synced from Aurum</p></div></header>{error&&<p className="alert">⚠️ {error}</p>}{info&&<section className="card profile"><div className="avatar">{String(credentials.nickname??credentials.email??"A")[0]?.toUpperCase()}</div><div><h2>{String(credentials.nickname??credentials.email??"Account")} {Boolean(info.prettyId)&&<span className="badge">#{String(info.prettyId)}</span>}</h2><p className="subtitle">{String(credentials.email??"")} {credentials.tgNickname?` · TG @${String(credentials.tgNickname)}`:""}</p></div></section>}<section className="stats">{summary.map((s)=><div className="card stat" key={s.ticker}><span className="stat-label">{s.ticker} · {s.count} tx</span>{s.in>0&&<span className="stat-line in">in +{number(s.in)} <small>{s.ticker}</small></span>}{s.out>0&&<span className="stat-line out">out −{number(s.out)} <small>{s.ticker}</small></span>}</div>)}<div className="card stat"><span className="stat-label">Transactions</span><span className="stat-value">{rows.length}</span></div></section><TransactionsTable rows={rows}/></main></div>}
